---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Payments — BoyKingTut.com">
<main class="detail-page">
<section class="detail-hero">
  <img src="/images/hero-eternal-spark.jpg" alt="Solana Payments" />
  <div class="detail-hero-copy">
    <p class="card-kicker">SOLANA PAYMENTS</p>
    <h1>Payment Information</h1>
    <p>This simple version keeps payment instructions static so the website remains easy to build and deploy.</p>
  </div>
</section>
<section class="page-section">
  <h2>Main Solana Wallet</h2>
  <div class="info-card"><p class="mono">4j4Rz7WHPHLdWm36db7d3LWexd3XtdPC4BxBiQ3jYmxS</p></div>
  <div class="notice-box">
    Confirm the correct service and amount before sending SOL. Blockchain transfers can be irreversible.
    BoyKingTut.com will never need your private key, seed phrase, or recovery phrase.
  </div>
</section>
</main>
</BaseLayout>
