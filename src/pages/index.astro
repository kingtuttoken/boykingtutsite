---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="BoyKingTut.com — Eternal Spark">
<div id="ageGate" class="gate">
<section class="gate-card"><p class="card-kicker">ACCESS & RISK NOTICE</p><h2>18+ ONLY</h2>
<div class="gate-copy"><p>BoyKingTut.com is for adults 18+.</p><p>Cryptocurrency and leveraged trading can cause rapid or total financial loss. Nothing here is financial, investment, legal, or tax advice.</p><p>Keep your SOL and recovery credentials under your own control. Never share seed phrases or private keys.</p></div>
<label class="check"><input id="ageCheck" type="checkbox"/> <span>I am 18+ and understand the notice.</span></label>
<div class="actions"><button id="enterBtn" class="gold-cta" disabled>AGREE & ENTER</button><button id="leaveBtn" class="dark-cta">DISAGREE</button></div>
</section></div>

<div id="jobPopup" class="job-popup" hidden><section class="popup-card"><p class="card-kicker">AFFILIATE / MAKE MONEY</p><h2>Are You Looking for a Job?</h2><p>Need money? Work for yourself. Introduce independent local businesses to the system. No signup fee and no planned monthly affiliate platform fee.</p><div class="actions"><a class="gold-cta" href="/affiliate">HOW TO BEGIN</a><button id="closeJob" class="dark-cta">NOT NOW</button></div></section></div>

<main class="home-shell">
<section class="cinematic-hero"><img class="cinematic-hero-image" src="/images/hero-eternal-spark.jpg" alt="Boy King Tut Eternal Spark"/><div class="cinematic-overlay"></div>
<div class="hero-branding"><div class="wing-mark">𓂀</div><p class="hero-eyebrow">BOY KING TUT</p><h1>ETERNAL SPARK</h1><p class="hero-quote">Knowledge • Freedom • Financial Power</p><p class="hero-subline">Build Your Reality.</p><div class="hero-buttons"><a class="gold-cta" href="#services">EXPLORE SERVICES</a><a class="discord-cta" href="https://discord.gg/HA73BUfJ67" target="_blank">JOIN DISCORD<small>discord.gg/HA73BUfJ67</small></a></div></div>
<div class="hero-right-quote"><strong>“BE YOU.”</strong><strong>BE ACTIVE.</strong><strong>WORK SMART</strong><strong>NOT HARD.</strong></div></section>

<section class="quick-strip"><a href="/crypto"><span>↗</span><b>CRYPTO LEVERAGE ALARMS</b><small>Solo Machine</small></a><a href="/affiliate"><span>♛</span><b>AFFILIATE / MAKE MONEY</b><small>Earn With Our System</small></a><a href="/advertising"><span>⌂</span><b>LOCAL ADVERTISING</b><small>Promote & Get Seen</small></a><a href="/metaverse"><span>◉</span><b>SECOND LIFE METAVERSE</b><small>Wild Hollow Experience</small></a><a href="/egypt"><span>△</span><b>EGYPT & ANCIENT KNOWLEDGE</b><small>History & Travel</small></a><a href="/knowledge"><span>▤</span><b>EDUCATIONAL HUB</b><small>Articles & Memoirs</small></a></section>

<section id="services" class="big-card-grid">
<article class="big-card"><img src="/images/card-crypto.jpg"/><div class="big-card-body"><p class="card-kicker">🚀 CRYPTO SERVICES</p><h2>Live Signals · Tools · Community</h2><ul><li>Experienced leverage trader alerts</li><li>Discord access</li><li>Solo machine</li></ul><a href="/crypto">EXPLORE CRYPTO</a></div></article>
<article class="big-card"><img src="/images/card-affiliate.jpg"/><div class="big-card-body"><p class="card-kicker">🚀 AFFILIATE / MAKE MONEY</p><h2>Local Business Opportunity</h2><ul><li>$0 signup fee</li><li>Recurring eligible commissions</li><li>Affiliate dashboard</li></ul><a href="/affiliate">JOIN AFFILIATE</a></div></article>
<article class="big-card cyan-card"><img src="/images/card-metaverse.jpg"/><div class="big-card-body"><p class="card-kicker cyan">🚀 METAVERSE</p><h2>Second Life — Wild Hollow</h2><ul><li>Public access</li><li>Community</li><li>Desktop + mobile</li></ul><a href="/metaverse">ENTER METAVERSE</a></div></article>
<article class="big-card"><img src="/images/card-egypt.jpg"/><div class="big-card-body"><p class="card-kicker">✦ EGYPT & TRAVEL</p><h2>Walk the Ancient Path</h2><ul><li>Grand Egyptian Museum</li><li>Giza & Abydos</li><li>Luxor, Saqqara & more</li></ul><a href="/egypt">EXPLORE EGYPT</a></div></article>
<article class="big-card"><img src="/images/card-knowledge.jpg"/><div class="big-card-body"><p class="card-kicker">▤ KNOWLEDGE HUB</p><h2>Articles · Book · TikTok</h2><ul><li>400+ memoirs</li><li>The Divine Human Codex</li><li>TikTok updates</li></ul><a href="/knowledge">READ & WATCH</a></div></article>
